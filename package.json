{
  "name": "geogebra-mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "MCP stdio server：托管 GeoGebra 离线页面，并把页面里的 ggbApplet API（构造 / 视图 / 导出）暴露成 MCP 工具。",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myLiLingyun/GeoGebraMCPServer.git"
  },
  "homepage": "https://github.com/myLiLingyun/GeoGebraMCPServer#readme",
  "bugs": {
    "url": "https://github.com/myLiLingyun/GeoGebraMCPServer/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "geogebra",
    "math",
    "dsh"
  ],
  "bin": {
    "geogebra-mcp-bridge": "./bin/geogebra-mcp-bridge.mjs"
  },
  "exports": {
    ".": "./src/server.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "web",
    "LICENSE",
    "LICENSE.CC-BY-NC-SA-4.0",
    "README.md"
  ],
  "scripts": {
    "check": "node test/list-tools.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
